# x402-meta-extract — example environment file. Copy to .env and fill in.
# No real keys or addresses belong in this repository.

# REQUIRED — recipient wallet address (EVM) for USDC payments on Base.
WALLET_ADDRESS=0x0000000000000000000000000000000000000000

# Optional — port the endpoint listens on (default 4020).
PORT=4020

# Optional — canonical resource URL advertised in the 402 challenge (e.g. https://your-host/extract).
PUBLIC_RESOURCE_URL=

# Optional — x402 facilitator (default: public CDP facilitator).
X402_FACILITATOR_URL=https://facilitator.x402.org

# Tests only — emulates verify+settle without touching the chain. NEVER set in production.
X402_MODE=

# Dev/test only — SSRF-guard escape hatch: '1'/'true' permits all private hosts,
# or a comma-separated hostname allowlist (e.g. 127.0.0.1). Leave unset in production.
ALLOW_PRIVATE_HOSTS=
